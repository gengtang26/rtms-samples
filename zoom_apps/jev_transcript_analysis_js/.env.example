# Zoom Marketplace app credentials and webhook verification token.
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"

# Web server and public Zoom App URL.
PORT=3000
PUBLIC_BASE_URL="https://YOUR_DOMAIN_HERE"
WEBHOOK_PATH="/webhook"
FRONTEND_WSS_URL_TO_CONNECT_TO="wss://YOUR_DOMAIN_HERE/ws"
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# OpenRouter key used server-side for the TypeSafe AI Jev Decisions API.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"
JEV_DECISIONS_URL="https://openrouter.ai/api/alpha/decisions"
JEV_MODEL="typesafe/jev-1.13"
JEV_TIMEOUT_MS=10000
JEV_HISTORY_TURNS=12
JEV_MIN_TRANSCRIPT_CHARACTERS=8

# Describe the offering and sales motion Jev should evaluate.
SALES_CONTEXT="B2B software sales conversation"
